<Window x:Class="BezBukv.App.KeyboardCalibrationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="{Binding [KeyboardCalibration_Title]}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Color x:Key="KeyboardBrandAccentLightColor">#FF0048CC</Color>
        <Color x:Key="KeyboardBrandAccentDarkColor">#FF006CFF</Color>
        <Color x:Key="CalibrationEmptyStrokeLightColor">#FF9AA0AA</Color>
        <Color x:Key="CalibrationEmptyStrokeDarkColor">#FF697082</Color>
        <SolidColorBrush x:Key="KeyboardBrandAccentBrush"
                         Color="#FF0048CC" />
        <SolidColorBrush x:Key="CalibrationEmptyStrokeBrush"
                         Color="#FF9AA0AA" />

        <Storyboard x:Key="CalibrationTapStoryboard"
                    RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                           Duration="0:0:1.15">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                        Value="-1.5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6325"
                                      Value="3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.15"
                                      Value="-1.5">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="CalibrationEscapeFadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-6"
                             To="0"
                             Duration="0:0:0.12" />
        </Storyboard>

        <Style x:Key="CalibrationRecordedKeycapStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Margin"
                    Value="3" />
            <Setter Property="Background"
                    Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness"
                    Value="1.3" />
            <Setter Property="CornerRadius"
                    Value="7" />
        </Style>

        <Style x:Key="CalibrationActiveKeycapStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Margin"
                    Value="3" />
            <Setter Property="Background"
                    Value="{DynamicResource KeyboardBrandAccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource KeyboardBrandAccentBrush}" />
            <Setter Property="BorderThickness"
                    Value="1.3" />
            <Setter Property="CornerRadius"
                    Value="7" />
        </Style>

        <Style x:Key="CalibrationAddButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource KeyboardBrandAccentBrush}" />
            <Setter Property="BorderThickness"
                    Value="1.6" />
            <Setter Property="Foreground"
                    Value="{DynamicResource KeyboardBrandAccentBrush}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource KeyboardBrandAccentBrush}"
                                    CornerRadius="7"
                                    Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HoverBackground"
                                        Property="Opacity"
                                        Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="HoverBackground"
                                        Property="Opacity"
                                        Value="0.12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalibrationActionIconViewboxStyle"
               TargetType="{x:Type Viewbox}">
            <Setter Property="Width"
                    Value="18" />
            <Setter Property="Height"
                    Value="18" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="SnapsToDevicePixels"
                    Value="True" />
            <Setter Property="Stretch"
                    Value="Uniform" />
        </Style>

        <Style x:Key="CalibrationActionIconPathStyle"
               TargetType="{x:Type Path}">
            <Setter Property="Width"
                    Value="24" />
            <Setter Property="Height"
                    Value="24" />
            <Setter Property="Fill"
                    Value="Transparent" />
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness"
                    Value="1.8" />
            <Setter Property="StrokeStartLineCap"
                    Value="Round" />
            <Setter Property="StrokeEndLineCap"
                    Value="Round" />
            <Setter Property="StrokeLineJoin"
                    Value="Round" />
            <Setter Property="Stretch"
                    Value="None" />
        </Style>

        <Style x:Key="CalibrationActionButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width"
                    Value="42" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Padding"
                    Value="11,6" />
            <Setter Property="Background"
                    Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalibrationEscapeButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Padding"
                    Value="9,0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource KeyboardBrandAccentBrush}" />
            <Setter Property="BorderThickness"
                    Value="1.6" />
            <Setter Property="Foreground"
                    Value="{DynamicResource KeyboardBrandAccentBrush}" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource KeyboardBrandAccentBrush}"
                                    CornerRadius="7"
                                    Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HoverBackground"
                                        Property="Opacity"
                                        Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="HoverBackground"
                                        Property="Opacity"
                                        Value="0.12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16"
            Padding="22,20,22,18"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.32"
                              ShadowDepth="4"
                              Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0"
                         Width="22"
                         Height="22"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center">
                    <Path Data="M2,6 L22,6 22,18 2,18 Z M6,10 L6.1,10 M10,10 L10.1,10 M14,10 L14.1,10 M18,10 L18.1,10 M8,14 L16,14"
                          Fill="Transparent"
                          Stroke="{DynamicResource KeyboardBrandAccentBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Viewbox>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding [KeyboardCalibration_Title]}" />

            </Grid>

            <TextBlock x:Name="HintText"
                       Grid.Row="1"
                       Margin="2,10,2,12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding [KeyboardCalibration_Hint]}"
                       TextWrapping="Wrap" />

            <Border x:Name="PreviewField"
                    Grid.Row="2"
                    Padding="16"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <ScrollViewer x:Name="RowsScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Button ToolTip="{Binding [KeyboardCalibration_Undo_ToolTip]}"
                            Click="OnUndoClick"
                            Style="{StaticResource CalibrationActionButtonStyle}">
                        <Viewbox Style="{StaticResource CalibrationActionIconViewboxStyle}">
                            <Path Data="M9,14 L4,9 9,4 M4,9 L15,9 C21,9 21,19 15,19 L11,19"
                                  Style="{StaticResource CalibrationActionIconPathStyle}" />
                        </Viewbox>
                    </Button>
                    <Button Margin="8,0,0,0"
                            ToolTip="{Binding [KeyboardCalibration_ResetRow_ToolTip]}"
                            Click="OnResetRowClick"
                            Style="{StaticResource CalibrationActionButtonStyle}">
                        <Viewbox Style="{StaticResource CalibrationActionIconViewboxStyle}">
                            <Path Data="M4.5,9.5 C5.7,5.6 9.8,3.3 13.9,4 C18.3,4.8 21.1,9 20.3,13.4 C19.5,17.8 15.3,20.6 10.9,19.8 C8,19.3 5.7,17.3 4.7,14.7 M4.5,4.5 L4.5,9.5 9.5,9.5"
                                  Style="{StaticResource CalibrationActionIconPathStyle}" />
                        </Viewbox>
                    </Button>
                    <Button Margin="8,0,0,0"
                            ToolTip="{Binding [KeyboardCalibration_NextRow_ToolTip]}"
                            Click="OnNextRowClick"
                            Style="{StaticResource CalibrationActionButtonStyle}">
                        <Viewbox Style="{StaticResource CalibrationActionIconViewboxStyle}">
                            <Path Data="M20,5 L20,10 C20,12.2 18.2,14 16,14 L5,14 M9,10 L4,14 9,18"
                                  Style="{StaticResource CalibrationActionIconPathStyle}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="PauseResumeButton"
                            Margin="8,0,0,0"
                            ToolTip="{Binding [KeyboardCalibration_Pause]}"
                            Click="OnPauseResumeClick"
                            Style="{StaticResource CalibrationActionButtonStyle}">
                        <Viewbox Style="{StaticResource CalibrationActionIconViewboxStyle}">
                            <Path Data="M8,6 L8,18 M16,6 L16,18"
                                  Style="{StaticResource CalibrationActionIconPathStyle}" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button ToolTip="{Binding [KeyboardCalibration_Cancel_ToolTip]}"
                            Click="OnCancelClick"
                            Style="{StaticResource CalibrationActionButtonStyle}">
                        <Viewbox Style="{StaticResource CalibrationActionIconViewboxStyle}">
                            <Path Data="M6,6 L18,18 M18,6 L6,18"
                                  Style="{StaticResource CalibrationActionIconPathStyle}" />
                        </Viewbox>
                    </Button>
                    <Button Margin="8,0,0,0"
                            ToolTip="{Binding [KeyboardCalibration_Finish_ToolTip]}"
                            Click="OnFinishClick"
                            Style="{StaticResource CalibrationActionButtonStyle}">
                        <Viewbox Style="{StaticResource CalibrationActionIconViewboxStyle}">
                            <Path Data="M4,12 L9,17 20,6"
                                  Style="{StaticResource CalibrationActionIconPathStyle}" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
