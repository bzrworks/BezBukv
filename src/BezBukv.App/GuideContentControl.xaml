<UserControl x:Class="BezBukv.App.GuideContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BezBukv.App">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionTitleStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Margin"
                    Value="0,0,0,2" />
        </Style>

        <Style x:Key="GuideSectionHeadingStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin"
                    Value="0,10,0,8" />
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <Style x:Key="GuideSubsectionHeadingStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin"
                    Value="0,8,0,8" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <Style x:Key="GuideSubSubHeadingStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin"
                    Value="0,8,0,8" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <Style x:Key="GuideParagraphStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin"
                    Value="0,0,0,10" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsBrandMutedBrush}" />
            <Setter Property="LineHeight"
                    Value="19" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>
    </UserControl.Resources>

