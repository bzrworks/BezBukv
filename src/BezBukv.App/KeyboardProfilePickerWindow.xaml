<Window x:Class="BezBukv.App.KeyboardProfilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="{Binding [KeyboardProfilePicker_Title]}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Color x:Key="KeyboardBrandAccentLightColor">#FF0048CC</Color>
        <Color x:Key="KeyboardBrandAccentDarkColor">#FF006CFF</Color>
        <SolidColorBrush x:Key="KeyboardBrandAccentBrush"
                         Color="#FF0048CC" />

        <Style x:Key="KeyboardProfileCardStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Height"
                    Value="128" />
            <Setter Property="Padding"
                    Value="12" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled"
                                               Value="True" />
                                    <Condition Property="IsMouseOver"
                                               Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CardBackground"
                                        Property="Background"
                                        Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyboardProfileSecondaryTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="TextAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="KeyboardKeyFillStyle"
               TargetType="{x:Type Rectangle}">
            <Setter Property="Fill"
                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Opacity"
                    Value="0.18" />
            <Setter Property="RadiusX"
                    Value="5" />
            <Setter Property="RadiusY"
                    Value="5" />
        </Style>

        <Style x:Key="KeyboardKeyOutlineStyle"
               TargetType="{x:Type Rectangle}">
            <Setter Property="Fill"
                    Value="Transparent" />
            <Setter Property="Stroke"
                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="StrokeThickness"
                    Value="1.2" />
            <Setter Property="RadiusX"
                    Value="5" />
            <Setter Property="RadiusY"
                    Value="5" />
        </Style>

        <Style x:Key="KeyboardAccentKeyOutlineStyle"
               BasedOn="{StaticResource KeyboardKeyOutlineStyle}"
               TargetType="{x:Type Rectangle}">
            <Setter Property="Stroke"
                    Value="{DynamicResource KeyboardBrandAccentBrush}" />
            <Setter Property="StrokeThickness"
                    Value="2.6" />
        </Style>

        <Style x:Key="KeyboardKeyLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="TextAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="KeyboardAccentKeyLabelStyle"
               BasedOn="{StaticResource KeyboardKeyLabelStyle}"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground"
                    Value="{DynamicResource KeyboardBrandAccentBrush}" />
        </Style>

        <Style x:Key="KeyboardLayoutListItemStyle"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="Height"
                    Value="25" />
            <Setter Property="Margin"
                    Value="0,2" />
            <Setter Property="Padding"
                    Value="8,2" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <EventSetter Event="MouseEnter"
                         Handler="OnLayoutItemMouseEnter" />
            <EventSetter Event="MouseLeave"
                         Handler="OnLayoutItemMouseLeave" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
                                <Setter TargetName="ItemBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource KeyboardBrandAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyboardLayoutScrollPageButtonStyle"
               TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyboardLayoutScrollThumbStyle"
               TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight"
                    Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBackground"
                                Background="{DynamicResource TextFillColorSecondaryBrush}"
                                CornerRadius="2"
                                Opacity="0.72" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBackground"
                                        Property="Opacity"
                                        Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBackground"
                                        Property="Opacity"
                                        Value="0.96" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyboardLayoutScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width"
                    Value="3" />
            <Setter Property="Orientation"
                    Value="Vertical" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Border Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                    CornerRadius="2"
                                    Opacity="0.4" />
                            <Track x:Name="PART_Track"
                                   Margin="0.5"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource KeyboardLayoutScrollPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource KeyboardLayoutScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource KeyboardLayoutScrollPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyboardLayoutListStyle"
               TargetType="{x:Type ListBox}">
            <Setter Property="Width"
                    Value="168" />
            <Setter Property="Height"
                    Value="128" />
            <Setter Property="Padding"
                    Value="2" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource KeyboardLayoutListItemStyle}" />
            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                                      Focusable="False">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                        </Grid.ColumnDefinitions>

                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                Grid.Column="0"
                                                                Margin="{TemplateBinding Padding}"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                                        <Border Grid.Column="1"
                                                Margin="2,2,1,2"
                                                HorizontalAlignment="Right"
                                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                                       HorizontalAlignment="Right"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       Style="{StaticResource KeyboardLayoutScrollBarStyle}"
                                                       Value="{TemplateBinding VerticalOffset}"
                                                       ViewportSize="{TemplateBinding ViewportHeight}" />
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Width="692"
            Margin="16"
            Padding="24"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.32"
                              ShadowDepth="4"
                              Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="176" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PickerHeading"
                       Grid.Row="0"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="{Binding [KeyboardProfilePicker_Title]}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <Grid x:Name="StandardStepGrid"
                  Grid.Row="1"
                  Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PickerSubtitle"
                           Grid.Row="0"
                           Grid.ColumnSpan="5"
                           HorizontalAlignment="Stretch"
                           Style="{StaticResource KeyboardProfileSecondaryTextStyle}"
                           Text="{Binding [KeyboardProfilePicker_Heading]}"
                           TextWrapping="Wrap" />

                <Button x:Name="WideEnterButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,12,0,0"
                        AutomationProperties.Name="{Binding [KeyboardProfilePicker_WideEnter_Title]}"
                        Click="OnAnsiClick"
                        Style="{StaticResource KeyboardProfileCardStyle}">
                    <Canvas Width="178.5"
                            Height="102">
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="19.5"
                              Canvas.Top="2.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_P]}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="53.5"
                              Canvas.Top="2.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_LeftBracket]}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="87.5"
                              Canvas.Top="2.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_RightBracket]}" />
                        </Grid>
                        <Grid Width="37.5"
                              Height="29"
                              Canvas.Left="121.5"
                              Canvas.Top="2.5">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardAccentKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardAccentKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Backslash]}" />
                        </Grid>

                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="19.5"
                              Canvas.Top="36.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Semicolon]}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="53.5"
                              Canvas.Top="36.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Apostrophe]}" />
                        </Grid>
                        <Grid Width="71.5"
                              Height="29"
                              Canvas.Left="87.5"
                              Canvas.Top="36.5">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardAccentKeyOutlineStyle}" />
                            <TextBlock FontSize="13"
                                       Style="{StaticResource KeyboardAccentKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Enter]}" />
                        </Grid>

                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="19.5"
                              Canvas.Top="70.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Period]}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="53.5"
                              Canvas.Top="70.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Slash]}" />
                        </Grid>
                        <Grid Width="71.5"
                              Height="29"
                              Canvas.Left="87.5"
                              Canvas.Top="70.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Shift]}" />
                        </Grid>
                    </Canvas>
                </Button>

                <Button x:Name="TallEnterButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,12,0,0"
                        AutomationProperties.Name="{Binding [KeyboardProfilePicker_TallEnter_Title]}"
                        Click="OnIsoClick"
                        Style="{StaticResource KeyboardProfileCardStyle}">
                    <Canvas Width="178.5"
                            Height="102">
                        <Grid Width="49.4"
                              Height="29"
                              Canvas.Left="2.5"
                              Canvas.Top="2.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Tab]}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="56.9"
                              Canvas.Top="2.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Q]}" />
                        </Grid>
                        <Grid Width="71.5"
                              Height="29"
                              Canvas.Left="104.5"
                              Canvas.Top="2.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Backspace]}" />
                        </Grid>

                        <Grid Width="49.4"
                              Height="29"
                              Canvas.Left="2.5"
                              Canvas.Top="36.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Caps]}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="56.9"
                              Canvas.Top="36.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_A]}" />
                        </Grid>

                        <Grid Width="49.4"
                              Height="29"
                              Canvas.Left="2.5"
                              Canvas.Top="70.5">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardAccentKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardAccentKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Shift]}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="56.9"
                              Canvas.Top="70.5">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardAccentKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardAccentKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Z]}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="104.5"
                              Canvas.Top="70.5">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardAccentKeyOutlineStyle}" />
                            <TextBlock Style="{StaticResource KeyboardAccentKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Backslash]}" />
                        </Grid>

                        <Path Data="M 104.5,41.5 Q 104.5,36.5 109.5,36.5 L 171,36.5 Q 176,36.5 176,41.5 L 176,94.5 Q 176,99.5 171,99.5 L 143.5,99.5 Q 138.5,99.5 138.5,94.5 L 138.5,70.5 Q 138.5,65.5 133.5,65.5 L 109.5,65.5 Q 104.5,65.5 104.5,60.5 Z"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}"
                              Opacity="0.18" />
                        <Path Data="M 104.5,41.5 Q 104.5,36.5 109.5,36.5 L 171,36.5 Q 176,36.5 176,41.5 L 176,94.5 Q 176,99.5 171,99.5 L 143.5,99.5 Q 138.5,99.5 138.5,94.5 L 138.5,70.5 Q 138.5,65.5 133.5,65.5 L 109.5,65.5 Q 104.5,65.5 104.5,60.5 Z"
                              Fill="Transparent"
                              Stroke="{DynamicResource KeyboardBrandAccentBrush}"
                              StrokeThickness="2.6" />
                        <Grid Width="71.5"
                              Height="29"
                              Canvas.Left="104.5"
                              Canvas.Top="36.5">
                            <TextBlock FontSize="13"
                                       Style="{StaticResource KeyboardAccentKeyLabelStyle}"
                                       Text="{Binding [KeyboardProfilePicker_Key_Enter]}" />
                        </Grid>
                    </Canvas>
                </Button>

                <Button x:Name="CustomButton"
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="0,12,0,0"
                        AutomationProperties.Name="{Binding [KeyboardProfilePicker_Custom_Title]}"
                        Click="OnCustomClick"
                        Style="{StaticResource KeyboardProfileCardStyle}"
                        ToolTip="{Binding [KeyboardProfilePicker_Custom_Tooltip]}">
                    <Canvas Width="178.5"
                            Height="102">
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="40.75"
                              Canvas.Top="2.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="74.75"
                              Canvas.Top="2.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="108.75"
                              Canvas.Top="2.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                        </Grid>

                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="40.75"
                              Canvas.Top="36.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="74.75"
                              Canvas.Top="36.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="108.75"
                              Canvas.Top="36.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                        </Grid>

                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="40.75"
                              Canvas.Top="70.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="74.75"
                              Canvas.Top="70.5"
                              Opacity="0.42">
                            <Rectangle Style="{StaticResource KeyboardKeyFillStyle}" />
                            <Rectangle Style="{StaticResource KeyboardKeyOutlineStyle}" />
                        </Grid>
                        <Grid Width="29"
                              Height="29"
                              Canvas.Left="109"
                              Canvas.Top="71">
                            <Rectangle Width="21"
                                       Height="5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource KeyboardBrandAccentBrush}"
                                       RadiusX="2"
                                       RadiusY="2" />
                            <Rectangle Width="5"
                                       Height="21"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource KeyboardBrandAccentBrush}"
                                       RadiusX="2"
                                       RadiusY="2" />
                        </Grid>
                    </Canvas>
                </Button>
            </Grid>

            <Grid x:Name="LayoutStepGrid"
                  Grid.Row="1"
                  Margin="0,18,0,0"
                  HorizontalAlignment="Center"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="168" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Style="{StaticResource KeyboardProfileSecondaryTextStyle}"
                           Text="{Binding [KeyboardProfilePicker_PrimaryLayout_Header]}" />

                <TextBlock Grid.Row="0"
                           Grid.Column="4"
                           Style="{StaticResource KeyboardProfileSecondaryTextStyle}"
                           Text="{Binding [KeyboardProfilePicker_SecondaryLayout_Header]}" />

                <ListBox x:Name="PrimaryLayoutList"
                         Grid.Row="1"
                         Grid.Column="0"
                         Margin="0,6,0,0"
                         AutomationProperties.Name="{Binding [KeyboardProfilePicker_PrimaryLayout_AutomationName]}"
                         PreviewKeyDown="OnLayoutListPreviewKeyDown"
                         PreviewMouseLeftButtonDown="OnLayoutListPreviewMouseLeftButtonDown"
                         SelectionChanged="OnPrimaryLayoutSelectionChanged"
                         Style="{StaticResource KeyboardLayoutListStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       Text="{Binding DisplayName}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="LayoutPreviewGrid"
                      Grid.Row="1"
                      Grid.Column="2"
                      Width="120"
                      Height="128"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                            BorderThickness="1"
                            CornerRadius="10" />

                    <Grid x:Name="DualSlotIndicators">
                        <Grid x:Name="PrimarySlotIndicator"
                              Width="44"
                              Height="44"
                              Margin="8"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                            <Rectangle x:Name="PrimarySlotFrame"
                                       Fill="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Stroke="{DynamicResource KeyboardBrandAccentBrush}"
                                       StrokeThickness="1.5"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="PrimarySlotLabel"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Text="1" />
                        </Grid>

                        <Grid x:Name="SecondarySlotIndicator"
                              Width="44"
                              Height="44"
                              Margin="8"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom">
                            <Rectangle x:Name="SecondarySlotFrame"
                                       Fill="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Stroke="{DynamicResource KeyboardBrandAccentBrush}"
                                       StrokeThickness="1.5"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="SecondarySlotLabel"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Text="2" />
                        </Grid>
                    </Grid>

                    <Grid x:Name="SingleSlotIndicator"
                          Width="58"
                          Height="58"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                        <Rectangle x:Name="SingleSlotFrame"
                                   Fill="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                   RadiusX="8"
                                   RadiusY="8"
                                   Stroke="{DynamicResource KeyboardBrandAccentBrush}"
                                   StrokeThickness="1.5"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="SingleSlotLabel"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Text="1" />
                    </Grid>
                </Grid>

                <ListBox x:Name="SecondaryLayoutList"
                         Grid.Row="1"
                         Grid.Column="4"
                         Margin="0,6,0,0"
                         AutomationProperties.Name="{Binding [KeyboardProfilePicker_SecondaryLayout_AutomationName]}"
                         PreviewKeyDown="OnLayoutListPreviewKeyDown"
                         PreviewMouseLeftButtonDown="OnLayoutListPreviewMouseLeftButtonDown"
                         SelectionChanged="OnSecondaryLayoutSelectionChanged"
                         Style="{StaticResource KeyboardLayoutListStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       Text="{Binding DisplayName}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</Window>
