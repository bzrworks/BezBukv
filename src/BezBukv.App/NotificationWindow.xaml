<Window x:Class="BezBukv.App.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:BezBukv.App.Resources"
        Title="{x:Static resources:AppStrings.Notification_Title}"
        MinWidth="320"
        MaxWidth="420"
        MaxHeight="280"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonUp="OnMouseLeftButtonUp">
    <Border Margin="16"
            Padding="18"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="16"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.32"
                              ShadowDepth="4"
                              Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="StatusGlyphBorder"
                    Grid.Column="0"
                    Width="28"
                    Height="28"
                    Margin="0,1,12,0"
                    VerticalAlignment="Top"
                    BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    CornerRadius="14"
                    Opacity="0.72">
                <TextBlock x:Name="StatusGlyph"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="15"
                           TextAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1"
                        MinWidth="242"
                        MaxWidth="320">
                <TextBlock x:Name="TitleTextBlock"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageTextBlock"
                           Margin="0,5,0,0"
                           Opacity="0.82"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
