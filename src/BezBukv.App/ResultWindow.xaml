<Window x:Class="BezBukv.App.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:BezBukv.App.Resources"
        Title="{x:Static resources:AppStrings.Result_Title}"
        MaxWidth="600"
        MaxHeight="640"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        PreviewMouseDown="OnPreviewMouseDown"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Margin="16"
            Padding="18"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.32"
                              ShadowDepth="4"
                              Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="ResultTextBox"
                     Grid.Row="0"
                     MinHeight="24"
                     MaxWidth="528"
                     MaxHeight="420"
                     Padding="0"
                     Background="Transparent"
                     BorderThickness="0"
                     IsReadOnly="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Visible"
                     HorizontalScrollBarVisibility="Disabled">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderBrush"
                                     Color="Transparent" />
                </TextBox.Resources>
            </TextBox>

            <Grid Grid.Row="1"
                  MaxWidth="528"
                  Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0"
                         Width="13"
                         Height="13"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center"
                         SnapsToDevicePixels="True"
                         Stretch="Uniform">
                    <Path Width="15"
                          Height="15"
                          Fill="{DynamicResource TextFillColorSecondaryBrush}"
                          Stretch="None">
                        <Path.Data>
                            <GeometryGroup FillRule="EvenOdd">
                                <EllipseGeometry Center="7.5,7.5"
                                                 RadiusX="7"
                                                 RadiusY="7" />
                                <EllipseGeometry Center="7.5,7.5"
                                                 RadiusX="5.75"
                                                 RadiusY="5.75" />
                                <EllipseGeometry Center="7.5,3.8"
                                                 RadiusX="1.1"
                                                 RadiusY="1.1" />
                                <RectangleGeometry Rect="6.45,6.4,2.1,5.1"
                                                   RadiusX="1.05"
                                                   RadiusY="1.05" />
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                </Viewbox>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static resources:AppStrings.Result_SelectionHint}"
                           TextWrapping="Wrap" />
            </Grid>

            <Grid Grid.Row="2"
                  Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Static SystemParameters.VerticalScrollBarWidth}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{x:Static SystemParameters.VerticalScrollBarWidth}" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="CopyButton"
                            Width="40"
                            Height="32"
                            Padding="0"
                            ToolTip="{x:Static resources:AppStrings.Result_CopyButton}"
                            AutomationProperties.Name="{x:Static resources:AppStrings.Result_CopyButton}"
                            Click="OnCopyClick">
                        <Viewbox Width="20"
                                 Height="20"
                                 SnapsToDevicePixels="True"
                                 Stretch="Uniform">
                            <Grid Width="24"
                                  Height="24">
                                <Path Data="M 8,4 H 18.5 A 1.5,1.5 0 0 1 20,5.5 V 16 A 1.5,1.5 0 0 1 18.5,17.5 H 17"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.8" />
                                <Path Data="M 5.5,7.5 H 15.5 A 1.5,1.5 0 0 1 17,9 V 19.5 A 1.5,1.5 0 0 1 15.5,21 H 5.5 A 1.5,1.5 0 0 1 4,19.5 V 9 A 1.5,1.5 0 0 1 5.5,7.5 Z"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.8" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="TryPasteButton"
                            Width="40"
                            Height="32"
                            Margin="8,0,0,0"
                            Padding="0"
                            ToolTip="{x:Static resources:AppStrings.Result_TryPasteButton}"
                            AutomationProperties.Name="{x:Static resources:AppStrings.Result_TryPasteButton}"
                            Click="OnTryPasteClick">
                        <Viewbox Width="22"
                                 Height="22"
                                 SnapsToDevicePixels="True"
                                 Stretch="Uniform">
                            <Grid Width="24"
                                  Height="24">
                                <Path Data="M 8,5.5 H 6.5 A 1.5,1.5 0 0 0 5,7 V 20 A 1.5,1.5 0 0 0 6.5,21.5 H 17.5 A 1.5,1.5 0 0 0 19,20 V 7 A 1.5,1.5 0 0 0 17.5,5.5 H 16"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.7" />
                                <Path Data="M 9,5.5 V 5 A 1.5,1.5 0 0 1 10.5,3.5 H 13.5 A 1.5,1.5 0 0 1 15,5 V 5.5 Z"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.7" />
                                <Path Data="M 9.2,10.7 C 9.2,9 10.4,7.9 12.05,7.9 C 13.7,7.9 14.9,8.9 14.9,10.45 C 14.9,11.85 14,12.45 13.05,13.15 C 12.3,13.7 12,14.2 12,15.1"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2.4" />
                                <Path Fill="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Path.Data>
                                        <EllipseGeometry Center="12,17.9"
                                                         RadiusX="1.3"
                                                         RadiusY="1.3" />
                                    </Path.Data>
                                </Path>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button Width="40"
                            Height="32"
                            Margin="8,0,0,0"
                            Padding="0"
                            ToolTip="{x:Static resources:AppStrings.Result_CloseButton}"
                            AutomationProperties.Name="{x:Static resources:AppStrings.Result_CloseButton}"
                            Click="OnCloseClick">
                        <Viewbox Width="21"
                                 Height="21"
                                 SnapsToDevicePixels="True"
                                 Stretch="Uniform">
                            <Path Width="24"
                                  Height="24"
                                  Data="M 5,5 L 19,19 M 19,5 L 5,19"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
