<Window x:Class="BezBukv.App.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BezBukv.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="{Binding [GuideWindow_Title]}"
        Width="820"
        Height="720"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Color x:Key="SettingsBrandMutedLightColor">#FF5D6470</Color>
        <Color x:Key="SettingsBrandMutedDarkColor">#FF9AA2B1</Color>
        <SolidColorBrush x:Key="SettingsBrandMutedBrush"
                         Color="#FF5D6470" />

        <Style x:Key="GuideCloseButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width"
                    Value="26" />
            <Setter Property="Height"
                    Value="26" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsBrandMutedBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Path Width="12"
                                  Height="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M1,1 L11,11 M11,1 L1,11"
                                  Stretch="None"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="CloseBackground"
                                        Property="Background"
                                        Value="#FFE5484D" />
                                <Setter TargetName="CloseBackground"
                                        Property="BorderBrush"
                                        Value="#FFE5484D" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="15,0,12,0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        CornerRadius="5"
                        ClipToBounds="True">
                    <Image RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/BezBukv.App;component/Assets/logo.png"
                           Stretch="Uniform" />
                </Border>
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding [GuideWindow_Title]}" />
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [Settings_Close]}"
                        Style="{StaticResource GuideCloseButtonStyle}"
                        Click="OnCloseClick" />
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Row="1"
                  Background="{DynamicResource LayerFillColorAltBrush}">
                <ScrollViewer Margin="30,26"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <local:GuideContentControl />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
