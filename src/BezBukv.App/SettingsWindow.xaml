<Window x:Class="BezBukv.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BezBukv.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="{Binding [Settings_Title]}"
        Width="900"
        Height="640"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Color x:Key="SettingsBrandAccentSoftLightColor">#FFE6EDFA</Color>
        <Color x:Key="SettingsBrandAccentSoftDarkColor">#FF0C315E</Color>
        <Color x:Key="SettingsBrandAccentInkLightColor">#FFFFFFFF</Color>
        <Color x:Key="SettingsBrandAccentInkDarkColor">#FFFFFFFF</Color>
        <Color x:Key="SettingsBrandMutedLightColor">#FF5D6470</Color>
        <Color x:Key="SettingsBrandMutedDarkColor">#FF9AA2B1</Color>
        <Color x:Key="SettingsKeycapShadowLightColor">#FF707780</Color>
        <Color x:Key="SettingsKeycapShadowDarkColor">#FF000000</Color>
        <Color x:Key="SettingsKeycapShadowColor">#FF707780</Color>
        <SolidColorBrush x:Key="SettingsBrandAccentBrush"
                         Color="{StaticResource SettingsBrandAccentLightColor}" />
        <SolidColorBrush x:Key="SettingsBrandAccentSoftBrush"
                         Color="#FFE6EDFA" />
        <SolidColorBrush x:Key="SettingsBrandAccentInkBrush"
                         Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SettingsBrandMutedBrush"
                         Color="#FF5D6470" />
        <SolidColorBrush x:Key="SettingsDangerBrush"
                         Color="#FFD13438" />

        <Style x:Key="SettingsNavigationItemStyle"
               TargetType="{x:Type RadioButton}">
            <Setter Property="Margin"
                    Value="0,0,0,2" />
            <Setter Property="Padding"
                    Value="11,9" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsBrandMutedBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Border x:Name="NavigationBackground"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SettingsBrandAccentBrush}"
                                    CornerRadius="0,3,3,0"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="NavigationBackground"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="NavigationBackground"
                                        Property="Background"
                                        Value="{DynamicResource SettingsBrandAccentSoftBrush}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsToggleStyle"
               TargetType="{x:Type ToggleButton}">
            <Setter Property="Width"
                    Value="40" />
            <Setter Property="Height"
                    Value="23" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="40"
                              Height="23">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedTrack"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="ToggleKnobTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedTrack"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="ToggleKnobTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="17"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedTrack"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="ToggleKnobTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="8.5"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    CornerRadius="12" />
                            <Border x:Name="CheckedTrack"
                                    Background="{DynamicResource SettingsBrandAccentBrush}"
                                    CornerRadius="12"
                                    Opacity="0" />
                            <Ellipse Width="19"
                                     Height="19"
                                     Margin="2,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3"
                                                      Direction="270"
                                                      Opacity="0.35"
                                                      ShadowDepth="1"
                                                      Color="Black" />
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ToggleKnobTransform" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRowStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Padding"
                    Value="2,15" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness"
                    Value="0,1,0,0" />
        </Style>

        <Style x:Key="SettingsFirstRowStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource SettingsRowStyle}">
            <Setter Property="BorderThickness"
                    Value="0" />
        </Style>

        <Style x:Key="SettingsDependentContentStyle"
               TargetType="{x:Type StackPanel}">
            <Setter Property="Opacity"
                    Value="1" />
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSectionTitleStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Margin"
                    Value="0,0,0,2" />
        </Style>

        <Style x:Key="SettingsSectionSubtitleStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin"
                    Value="0,0,0,20" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsBrandMutedBrush}" />
            <Setter Property="LineHeight"
                    Value="19" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <Style x:Key="SettingsRowLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <Style x:Key="SettingsRowDescriptionStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin"
                    Value="0,3,18,0" />
            <Setter Property="FontSize"
                    Value="12.5" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsBrandMutedBrush}" />
            <Setter Property="LineHeight"
                    Value="18" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <Style x:Key="SettingsKeycapStyle"
               TargetType="{x:Type Border}">
            <Setter Property="MinWidth"
                    Value="24" />
            <Setter Property="Padding"
                    Value="8,5" />
            <Setter Property="Background"
                    Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="7" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="0"
                                      Direction="270"
                                      Opacity="0.42"
                                      ShadowDepth="1.5"
                                      Color="{DynamicResource SettingsKeycapShadowColor}" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsLinkButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Padding"
                    Value="4,5" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="12.5" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="IsHitTestVisible"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter Property="Cursor"
                            Value="Arrow" />
                    <Setter Property="Opacity"
                            Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsNumberTextBoxStyle"
               TargetType="{x:Type TextBox}">
            <Setter Property="Width"
                    Value="74" />
            <Setter Property="Padding"
                    Value="10,7" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Right" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="IsReadOnly"
                    Value="True" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="IsHitTestVisible"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsNumberFieldStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Width"
                    Value="110" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="8" />
        </Style>

        <Style x:Key="SettingsGhostButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Padding"
                    Value="13,7" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontSize"
                    Value="12.5" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="IsHitTestVisible"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter Property="Cursor"
                            Value="Arrow" />
                    <Setter Property="Opacity"
                            Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsAccentButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SettingsGhostButtonStyle}">
            <Setter Property="Padding"
                    Value="18,9" />
            <Setter Property="FontSize"
                    Value="13.5" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsBrandAccentInkBrush}" />
            <Setter Property="Background"
                    Value="{DynamicResource SettingsBrandAccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SettingsBrandAccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter Property="Background"
                            Value="{DynamicResource ControlFillColorDisabledBrush}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="Cursor"
                            Value="Arrow" />
                    <Setter Property="Opacity"
                            Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsCloseButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width"
                    Value="26" />
            <Setter Property="Height"
                    Value="26" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsBrandMutedBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Path Width="12"
                                  Height="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M1,1 L11,11 M11,1 L1,11"
                                  Stretch="None"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="CloseBackground"
                                        Property="Background"
                                        Value="#FFE5484D" />
                                <Setter TargetName="CloseBackground"
                                        Property="BorderBrush"
                                        Value="#FFE5484D" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsIconButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width"
                    Value="30" />
            <Setter Property="Height"
                    Value="30" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="IconBackground"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="15,0,12,0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        CornerRadius="5"
                        ClipToBounds="True">
                    <Image RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/BezBukv.App;component/Assets/logo.png"
                           Stretch="Uniform" />
                </Border>
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding [Settings_About_ProductName]}" />
                <TextBlock Grid.Column="2"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontWeight="Normal"
                           Text="{Binding [Settings_Header_SettingsSuffix]}" />
                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [Settings_Close]}"
                        Style="{StaticResource SettingsCloseButtonStyle}"
                        Click="OnCloseClick" />
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Row="1"
                  Background="{DynamicResource LayerFillColorAltBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="10,12"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <RadioButton x:Name="GeneralNavigationButton"
                                         GroupName="SettingsNavigation"
                                         IsChecked="True"
                                         Style="{StaticResource SettingsNavigationItemStyle}"
                                         Checked="OnNavigationChecked">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="17"
                                          Height="17">
                                        <Ellipse Width="5"
                                                 Height="5"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                                 StrokeThickness="1.7" />
                                        <Path Data="M8.5,0.8 L8.5,3 M8.5,14 L8.5,16.2 M0.8,8.5 L3,8.5 M14,8.5 L16.2,8.5 M3.05,3.05 L4.6,4.6 M12.4,12.4 L13.95,13.95 M13.95,3.05 L12.4,4.6 M4.6,12.4 L3.05,13.95"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Grid>
                                    <TextBlock Margin="11,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding [Settings_Nav_General]}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="CorrectionNavigationButton"
                                         GroupName="SettingsNavigation"
                                         Style="{StaticResource SettingsNavigationItemStyle}"
                                         Checked="OnNavigationChecked">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="17"
                                          Height="17">
                                        <Path Data="M1,5 L11,5 M1,5 L4,2 M1,5 L4,8 M16,12 L6,12 M16,12 L13,9 M16,12 L13,15"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Grid>
                                    <TextBlock Margin="11,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding [Settings_Nav_Correction]}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PeekNavigationButton"
                                         GroupName="SettingsNavigation"
                                         Style="{StaticResource SettingsNavigationItemStyle}"
                                         Checked="OnNavigationChecked">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="17"
                                          Height="17">
                                        <Path Data="M2,3 L15,3 Q16,3 16,4 L16,13 Q16,14 15,14 L2,14 Q1,14 1,13 L1,4 Q1,3 2,3 Z M4,7 L4.05,7 M7,7 L7.05,7 M10,7 L10.05,7 M5,11 L12,11"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Grid>
                                    <TextBlock Margin="11,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding [Settings_Nav_Peek]}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="AdvancedNavigationButton"
                                         GroupName="SettingsNavigation"
                                         Style="{StaticResource SettingsNavigationItemStyle}"
                                         Checked="OnNavigationChecked">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="17"
                                          Height="17">
                                        <Path Data="M4,1 L4,6 M4,11 L4,16 M8.5,1 L8.5,10 M8.5,15 L8.5,16 M13,1 L13,3 M13,8 L13,16 M2,8.5 A2,2 0 1 0 6,8.5 A2,2 0 1 0 2,8.5 M6.5,12.5 A2,2 0 1 0 10.5,12.5 A2,2 0 1 0 6.5,12.5 M11,5.5 A2,2 0 1 0 15,5.5 A2,2 0 1 0 11,5.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Grid>
                                    <TextBlock Margin="11,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding [Settings_Nav_Advanced]}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="GuideNavigationButton"
                                         GroupName="SettingsNavigation"
