                                    <Path Width="16"
                                          Height="16"
                                          VerticalAlignment="Top"
                                          Data="M8,1.5 L15,14.5 L1,14.5 Z M8,5.5 L8,10 M8,12.5 L8,12.55"
                                          Stretch="Fill"
                                          Stroke="{DynamicResource SystemFillColorCautionBrush}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Grid.Column="1"
                                               Margin="11,0,0,0"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               LineHeight="18"
                                               Text="{Binding [Settings_Advanced_Warning]}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,22,0,2"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding [Settings_Advanced_CorrectionGroup]}"
                                       TextWrapping="Wrap" />

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}"
                                                   Text="{Binding [Settings_Advanced_CopyTimeout]}" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionStyle}"
                                                   Text="{Binding [Settings_Advanced_CopyTimeoutDescription]}" />
                                    </StackPanel>
                                    <Border x:Name="CopyTimeoutFieldBorder"
                                            Grid.Column="1"
                                            Style="{StaticResource SettingsNumberFieldStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CopyTimeoutTextBox"
                                                     Grid.Column="0"
                                                     Focusable="True"
                                                     IsHitTestVisible="True"
                                                     IsReadOnly="False"
                                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                                     Text="{Binding [Settings_Advanced_CopyTimeoutValue], Mode=OneTime}"
                                                     GotKeyboardFocus="OnAdvancedValueGotKeyboardFocus"
                                                     KeyDown="OnAdvancedValueKeyDown"
                                                     LostKeyboardFocus="OnAdvancedValueLostKeyboardFocus"
                                                     TextChanged="OnAdvancedValueTextChanged" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SettingsBrandMutedBrush}"
                                                       Text="{Binding [Settings_Unit_Milliseconds]}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}"
                                                   Text="{Binding [Settings_Advanced_MaxTextSize]}" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionStyle}"
                                                   Text="{Binding [Settings_Advanced_MaxTextSizeDescription]}" />
                                    </StackPanel>
                                    <Border x:Name="TextLimitKilobytesFieldBorder"
                                            Grid.Column="1"
                                            Style="{StaticResource SettingsNumberFieldStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TextLimitKilobytesTextBox"
                                                     Grid.Column="0"
                                                     Padding="10,7,14,7"
                                                     Focusable="True"
                                                     IsHitTestVisible="True"
                                                     IsReadOnly="False"
                                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                                     Text="{Binding [Settings_Advanced_MaxTextSizeValue], Mode=OneTime}"
                                                     GotKeyboardFocus="OnAdvancedValueGotKeyboardFocus"
                                                     KeyDown="OnAdvancedValueKeyDown"
                                                     LostKeyboardFocus="OnAdvancedValueLostKeyboardFocus"
                                                     TextChanged="OnAdvancedValueTextChanged" />
                                            <TextBlock Grid.Column="0"
                                                       Width="8"
                                                       Margin="0,0,6,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SettingsBrandMutedBrush}"
                                                       Text="K" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="0,0,4,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SettingsBrandMutedBrush}"
                                                       Text="{Binding [Settings_Unit_Characters]}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}"
                                                   Text="{Binding [Settings_Advanced_ClipboardRestoreDelay]}" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionStyle}"
                                                   Text="{Binding [Settings_Advanced_ClipboardRestoreDelayDescription]}" />
                                    </StackPanel>
                                    <Border x:Name="ClipboardRestoreDelayFieldBorder"
                                            Grid.Column="1"
                                            Style="{StaticResource SettingsNumberFieldStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ClipboardRestoreDelayTextBox"
                                                     Grid.Column="0"
                                                     Focusable="True"
                                                     IsHitTestVisible="True"
                                                     IsReadOnly="False"
                                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                                     Text="{Binding [Settings_Advanced_ClipboardRestoreDelayValue], Mode=OneTime}"
                                                     GotKeyboardFocus="OnAdvancedValueGotKeyboardFocus"
                                                     KeyDown="OnAdvancedValueKeyDown"
                                                     LostKeyboardFocus="OnAdvancedValueLostKeyboardFocus"
                                                     TextChanged="OnAdvancedValueTextChanged" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SettingsBrandMutedBrush}"
                                                       Text="{Binding [Settings_Unit_Milliseconds]}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}"
                                                   Text="{Binding [Settings_Correction_TryPasteUnknown]}" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionStyle}"
                                                   Text="{Binding [Settings_Correction_TryPasteUnknownDescription]}" />
                                    </StackPanel>
                                    <ToggleButton x:Name="PasteIntoUnknownToggle"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource SettingsToggleStyle}" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,22,0,2"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding [Settings_Advanced_PeekGroup]}"
                                       TextWrapping="Wrap" />

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}"
                                                   Text="{Binding [Settings_Advanced_PeekAutoExit]}" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionStyle}"
                                                   Text="{Binding [Settings_Advanced_PeekAutoExitDescription]}" />
                                    </StackPanel>
                                    <Border x:Name="PeekAutoExitFieldBorder"
                                            Grid.Column="1"
                                            Style="{StaticResource SettingsNumberFieldStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PeekAutoExitTextBox"
                                                     Grid.Column="0"
                                                     Focusable="True"
                                                     IsHitTestVisible="True"
                                                     IsReadOnly="False"
                                                     Style="{StaticResource SettingsNumberTextBoxStyle}"
                                                     Text="{Binding [Settings_Advanced_PeekAutoExitValue], Mode=OneTime}"
                                                     GotKeyboardFocus="OnAdvancedValueGotKeyboardFocus"
                                                     KeyDown="OnAdvancedValueKeyDown"
                                                     LostKeyboardFocus="OnAdvancedValueLostKeyboardFocus"
                                                     TextChanged="OnAdvancedValueTextChanged" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SettingsBrandMutedBrush}"
                                                       Text="{Binding [Settings_Unit_Seconds]}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="GuidePanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <local:GuideContentControl />
                            <Button x:Name="OpenGuideWindowButton"
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="{Binding [Settings_Guide_OpenWindowToolTip]}"
                                    Focusable="True"
                                    ToolTip="{Binding [Settings_Guide_OpenWindowToolTip]}"
                                    Style="{StaticResource SettingsIconButtonStyle}"
                                    Click="OnOpenGuideWindowClick">
                                <Path Width="16"
                                      Height="16"
                                      Data="M6,3 L14,3 L14,11 M14,3 L7,10 M12,9 L12,14 L3,14 L3,5 L8,5"
                                      Stretch="None"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Button>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Padding="16,0"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="ImportButton"
                                MinWidth="72"
                                Content="{Binding [Settings_Footer_Import]}"
                                Focusable="True"
                                IsHitTestVisible="True"
                                Style="{StaticResource SettingsGhostButtonStyle}"
                                Click="OnImportClick" />
                        <Button x:Name="ExportButton"
                                Margin="10,0,0,0"
                                MinWidth="72"
                                Content="{Binding [Settings_Footer_Export]}"
                                Focusable="True"
                                IsHitTestVisible="True"
                                Style="{StaticResource SettingsGhostButtonStyle}"
                                Click="OnExportClick" />
                    </StackPanel>
                    <Button x:Name="ResetButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="{Binding [Settings_Footer_Reset]}"
                            Focusable="True"
                            IsHitTestVisible="True"
                            Style="{StaticResource SettingsGhostButtonStyle}"
                            Click="OnResetClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
